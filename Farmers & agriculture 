def _load_env_file(path):     # .env next to this file; real environment variables always win
    try:
        for ln in open(path, encoding="utf-8"):
            ln = ln.strip()
            if ln and not ln.startswith("#") and "=" in ln:
                k, _, v = ln.partition("=")
                os.environ.setdefault(k.strip(), v.strip().strip("\"'"))
    except OSError:
        pass


